# ---------------------------------------------------------------------------
# Lintel — environment variables (copy to .env.local and fill in)
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (London/EU region project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Billing + Customer Portal)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs (create in Stripe dashboard; 30-day trial set on the base item)
STRIPE_PRICE_CORE=
STRIPE_PRICE_VOICE=
STRIPE_PRICE_TENANT_PORTAL=
STRIPE_PRICE_MAINTENANCE_PORTAL=
STRIPE_PRICE_BUNDLE=

# SendGrid (verified domain, SPF/DKIM)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@lintel.app
SENDGRID_FROM_NAME=Lintel

# Cron (Vercel Cron shared secret to guard /api/cron/* routes)
CRON_SECRET=

# HMRC MTD ITSA (Phase 7) — provider stays 'local' until recognition is granted
MTD_PROVIDER=local              # 'local' | 'hmrc'
MTD_HMRC_ENV=sandbox            # 'sandbox' | 'production'
MTD_HMRC_RECOGNISED=false       # flip to true ONLY once HMRC recognition is granted
MTD_HMRC_CLIENT_ID=
MTD_HMRC_CLIENT_SECRET=
MTD_HMRC_REDIRECT_URI=          # defaults to ${NEXT_PUBLIC_APP_URL}/api/hmrc/callback

# Google Places (address autocomplete on Add property) — optional; form falls
# back to manual entry if unset. Restrict the key to your domain + Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
