# ---------------------------------------------------------------------------
# Lintel — environment variables (copy to .env.local and fill in)
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (London/EU region project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Billing + Customer Portal)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs (create in Stripe dashboard; 30-day trial set on the base item)
STRIPE_PRICE_CORE=
STRIPE_PRICE_VOICE=
STRIPE_PRICE_TENANT_PORTAL=
STRIPE_PRICE_MAINTENANCE_PORTAL=
STRIPE_PRICE_BUNDLE=

# SendGrid (verified domain, SPF/DKIM)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@lintel.app
SENDGRID_FROM_NAME=Lintel

# Cron (Vercel Cron shared secret to guard /api/cron/* routes)
CRON_SECRET=
