{
  "expo": {
    "name": "Lintel Squared",
    "slug": "lintel",
    "version": "1.0.0",
    "scheme": "lintel",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#16233A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meyerdigital.lintel",
      "infoPlist": {
        "CFBundleDisplayName": "Lintel²",
        "NSCameraUsageDescription": "Lintel Squared uses the camera to photograph receipts and document property maintenance.",
        "NSPhotoLibraryUsageDescription": "Lintel Squared attaches photos to expenses, documents and maintenance reports.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.meyerdigital.lintel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#16233A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lintel Squared to attach photos from your library."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon.png",
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cbe1a26c-fc0d-4c36-9506-e72e2c7c06af"
      }
    }
  }
}
